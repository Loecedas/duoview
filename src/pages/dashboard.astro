---
import Layout from '../layouts/Layout.astro';
import DashboardApp from '../components/DashboardApp';

const username = Astro.url.searchParams.get('user') || '';
---
<Layout>
  {username ? (
    <DashboardApp username={username} client:load />
  ) : (
    <div class="min-h-screen flex flex-col justify-between items-center py-8">
      <div class="flex-1 flex flex-col items-center justify-center text-center">
        <p class="text-gray-600 text-lg mb-4">未提供用户名</p>
        <a href="/" class="text-[#1cb0f6] font-bold hover:underline">← 返回首页</a>
      </div>
      <footer class="text-center text-xs text-gray-400 pb-2">
        © 2026 · DuoView 非官方工具
      </footer>
    </div>
  )}
</Layout>
